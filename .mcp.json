{
  "mcpServers": {
    "agentregistry": {
      "type": "streamable-http",
      "url": "http://localhost:8083/mcp"
    },
    "open-aware": {
      "type": "streamable-http",
      "url": "https://open-aware.qodo.ai/mcp"
    },
    "genkit": {
      "command": "genkit",
      "args": [
        "mcp",
        "--no-update-notification"
      ]
    }
  }
}
